{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_paths": {
      "items": {
        "maxLength": 300,
        "type": "string"
      },
      "maxItems": 5,
      "type": "array"
    },
    "blockers": {
      "items": {
        "maxLength": 300,
        "type": "string"
      },
      "maxItems": 5,
      "type": "array"
    },
    "decision_needed": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_facts": {
      "items": {
        "maxLength": 300,
        "type": "string"
      },
      "maxItems": 5,
      "type": "array"
    },
    "status": {
      "enum": [
        "completed",
        "decision_needed"
      ],
      "type": "string"
    },
    "verified_comparisons": {
      "items": {
        "maxLength": 300,
        "type": "string"
      },
      "maxItems": 5,
      "type": "array"
    }
  },
  "required": [
    "status",
    "observed_facts",
    "verified_comparisons",
    "artifact_paths",
    "blockers",
    "decision_needed"
  ],
  "title": "delegate result",
  "type": "object"
}
